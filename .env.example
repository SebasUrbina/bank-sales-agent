APP_ENV=local
MODEL_NAME=openai:gpt-5-mini
OPENAI_API_KEY=
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_ACCESS_TOKEN=
# En produccion, la identidad debe venir de Google/OIDC o de un proxy confiable.
ALLOW_INSECURE_DEV_IDENTITY=true
# false usa un transport local; true usa ADC/Workload Identity y Google Chat API.
GOOGLE_CHAT_ENABLED=false

APP_ENV=local
API__TITLE=Bank Sales Agent
API__VERSION=0.1.0
API__DOCS_ENABLED=true

LLM_GATEWAY__BASE_URL=https://apim.bank.example/llms
LLM_GATEWAY__MODEL_NAME=openai:gpt-5-mini
LLM_GATEWAY__API_KEY=
LLM_GATEWAY__SUBSCRIPTION_KEY=
LLM_GATEWAY__TIMEOUT_SECONDS=60
LLM_GATEWAY__MAX_RETRIES=2

# Requerido para APP_ENV=dsr, qa o prd. En local se usa InMemorySaver.
MONGODB__URI=
MONGODB__DATABASE=bank_sales_agent
MONGODB__CHECKPOINT_COLLECTION=checkpoints
MONGODB__WRITES_COLLECTION=checkpoint_writes

# false usa un transport local; true usa ADC/Workload Identity y Google Chat API.
GOOGLE_CHAT__ENABLED=false
GOOGLE_CHAT__REQUEST_TIMEOUT_SECONDS=20

# Servidor MCP externo; requiere el mismo secreto de firma que mcp-server/.env.
MCP__URL=http://127.0.0.1:8001/mcp
MCP__SIGNING_SECRET=<reemplazar-por-un-secreto-de-al-menos-32-caracteres>
MCP__TIMEOUT_SECONDS=30
MCP__TOKEN_TTL_SECONDS=120

# Skills de la aplicación; rutas locales o volúmenes administrados. [] las deshabilita.
AGENT_SKILLS__DIRECTORIES=["skills"]
AGENT_SKILLS__MAX_FILE_BYTES=262144
